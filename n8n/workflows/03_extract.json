[{
  "id": "03_extract",
  "name": "Extract Protocol Data",
  "active": false,
  "nodes": [
    {
      "id": "5d1eca6d-7eff-4cae-984a-9a0d49402889",
      "name": "Start",
      "type": "n8n-nodes-base.workflowTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {}
    },
    {
      "id": "9c98156c-b0e4-4849-b427-16df6820e11c",
      "name": "Prepare System Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [450, 300],
      "parameters": {
        "mode": "define",
        "values": {
          "string": [
            {
              "name": "system_prompt",
              "value": "You are a protocol extraction expert. Given a verification protocol document, extract structured fields: organization, verification_date, expiration_date, device_type, device_id, status, and certificate_number. Return valid JSON only."
            },
            {
              "name": "model",
              "value": "gpt-4o"
            },
            {
              "name": "temperature",
              "value": "0.1"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7b0e5c86-cf84-4164-afc4-c94d34d35581",
      "name": "AI Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/ai/extract",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $json.model }}"
            },
            {
              "name": "temperature",
              "value": "={{ $json.temperature }}"
            },
            {
              "name": "messages",
              "value": "={{ [{\"role\": \"system\", \"content\": $json.system_prompt}, {\"role\": \"user\", \"content\": JSON.stringify($json.protocol_text || $json)}] }}"
            }
          ]
        },
        "options": {
          "bodyContentType": "json"
        }
      }
    },
    {
      "id": "9bdb664c-49f9-4cd8-b033-bd5e44ff5732",
      "name": "Validate Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [850, 300],
      "parameters": {
        "language": "javascript",
        "code": "const data = $input.first().json;\n\nlet confidence = data.confidence || 0;\nlet isHardCase = false;\nlet missingFields = [];\n\nconst requiredFields = ['organization', 'verification_date', 'device_type', 'device_id', 'status'];\nfor (const field of requiredFields) {\n  if (!data[field] && !data.extracted_data?.[field]) {\n    missingFields.push(field);\n  }\n}\n\nif (missingFields.length > 0 || confidence < 0.8 || data.requires_review === true) {\n  isHardCase = true;\n}\n\nreturn [{\n  ...data,\n  isHardCase,\n  missingFields,\n  confidence,\n  validated: true\n}];"
      }
    },
    {
      "id": "8dc105b5-ad85-48a2-bdee-3622be609194",
      "name": "Check Hard Case",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300],
      "parameters": {
        "conditions": {
          "number": [],
          "string": [],
          "boolean": [
            {
              "leftValue": "={{ $json.isHardCase }}",
              "rightValue": true,
              "operation": "equal"
            }
          ]
        }
      }
    },
    {
      "id": "8fce72aa-77ef-4bc1-a2f9-7871fd7555f1",
      "name": "Enhanced Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1250, 150],
      "parameters": {
        "mode": "define",
        "values": {
          "string": [
            {
              "name": "system_prompt",
              "value": "You are a protocol extraction specialist. The previous attempt had low confidence or missing fields. Review the document carefully and extract all required fields precisely. Focus on: organization, verification_date, expiration_date, device_type, device_id, status, certificate_number. Return ONLY valid JSON."
            },
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "temperature",
              "value": "0.05"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e92036a2-0612-47eb-a782-7755664bdac6",
      "name": "AI Retry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1450, 150],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/ai/extract",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "={{ $json.model }}"
            },
            {
              "name": "temperature",
              "value": "={{ $json.temperature }}"
            },
            {
              "name": "messages",
              "value": "={{ [{\"role\": \"system\", \"content\": $json.system_prompt}, {\"role\": \"user\", \"content\": JSON.stringify($json.original_text || $json)}] }}"
            }
          ]
        },
        "options": {
          "bodyContentType": "json"
        }
      }
    },
    {
      "id": "27c45c07-2b7e-4d34-980a-e7466067e175",
      "name": "Validate Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1650, 150],
      "parameters": {
        "language": "javascript",
        "code": "const data = $input.first().json;\n\nreturn [{\n  ...data,\n  retry_used: true,\n  final_confidence: data.confidence || 0,\n  validated: true\n}];"
      }
    },
    {
      "id": "aa24bc23-4ce8-491e-98f7-912960b282c5",
      "name": "Final Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1500, 450],
      "parameters": {
        "mode": "define",
        "values": {
          "string": [
            {
              "name": "extraction_complete",
              "value": "true"
            }
          ],
          "number": [
            {
              "name": "confidence_score",
              "value": "={{ $json.confidence || $json.final_confidence || 0 }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "541533c8-cf47-4e44-a1cd-35b487acb90b",
      "name": "Return Data",
      "type": "n8n-nodes-base.return",
      "typeVersion": 1,
      "position": [1700, 450],
      "parameters": {}
    }
  ],
