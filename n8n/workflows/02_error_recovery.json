      "typeVersion": 2,
      "position": [450, 300],
      "parameters": {
        "mode": "define",
        "values": {
          "string": [
            {
              "name": "system_prompt",
              "value": "You are a protocol extraction assistant. Extract structured data from the provided protocol text and return JSON with fields: protocol_id, organization, date, status, and extracted_data."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "42022c84-6a02-4db2-a6ae-87852e790f44",
      "name": "AI Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/ai/extract",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "temperature",
              "value": 0.05
            },
            {
              "name": "messages",
              "value": "={{ [{\"role\": \"system\", \"content\": $json.system_prompt}, {\"role\": \"user\", \"content\": JSON.stringify($json)}] }}"
            }
          ]
        },
        "options": {
          "bodyContentType": "json"
        }
      }
    },
    {
      "id": "0e3ffc7e-95a0-4a08-a8df-b79eea1e15a9",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [850, 300],
      "parameters": {
        "language": "javascript",
        "code": "const data = $input.first().json;\n\nlet success = false;\nlet protocol_id = null;\n\nif (data && !data.error && data.protocol_id) {\n  success = true;\n  protocol_id = data.protocol_id;\n}\n\nreturn [{ \n  success,\n  protocol_id,\n  original_data: data,\n  validated: true \n}];"
      }
    },
    {
      "id": "52a86274-7e8d-43da-91f2-e25760748f60",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 300],
      "parameters": {
        "conditions": {
          "number": [],
          "string": [],
          "boolean": [
            {
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operation": "equal"
            }
          ]
        }
      }
    },
    {
      "id": "befe4963-4787-4887-a3a2-a5f7442ed6a4",
      "name": "Update Protocol Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 150],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/protocols/{{ $json.protocol_id }}/status",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "recovered"
            },
            {
              "name": "extracted_data",
              "value": "={{ $json.original_data }}"
            }
          ]
        },
        "options": {
          "bodyContentType": "json"
        }
      }
    }
