# .env для token-agent
# Путь к файлу токена. Если путь содержит пробелы или кириллицу — оберни в кавычки.
# Рекомендуется использовать прямые слеши / вместо обратных \, чтобы не экранировать.
TOKEN_FILE_PATH="C:/Users/Zonov/SynologyDrive/Метрологическая лаборатория/tokens/arshin-token.json"

# Адрес и порт локального сервера
TOKEN_AGENT_HOST=127.0.0.1
TOKEN_AGENT_PORT=8003

# Лог-файл агента (по умолчанию token-agent.log в папке агента)
TOKEN_AGENT_LOG=token-agent.log
