# Пример настроек агента токена ARSHIN
# Скопируй этот файл в .env и укажи свой путь.

# ВАЖНО:
# Замени REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH на реальный путь
# к папке Synology Drive на этом компьютере.
#
# Как узнать путь:
#   1. Открой Проводник Windows
#   2. Перейди в папку SynologyDrive
#   3. Нажми на адресную строку сверху и скопируй путь
#   4. Вставь его ниже вместо REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH
#   5. Можно использовать \ или /
#
# В конце пути должно быть /tokens/arshin-token.json

TOKEN_FILE_PATH=REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH/tokens/arshin-token.json

# Адрес прослушивания. Оставь 127.0.0.1 — только для локального расширения Chrome.
TOKEN_AGENT_HOST=127.0.0.1

# Порт. Расширение Chrome отправляет запросы на http://127.0.0.1:8003
TOKEN_AGENT_PORT=8003

# Путь к лог-файлу (необязательно, по умолчанию token-agent.log рядом с main.py)
# TOKEN_AGENT_LOG=REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH/tokens/token-agent.log
