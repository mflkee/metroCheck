# ARSHIN Token Agent configuration example
# Copy this file to .env and set your real Synology Drive path.

# IMPORTANT:
# Replace REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH with the actual full path
# to your Synology Drive folder on this Windows PC.
#
# How to find the path:
#   1. Open File Explorer
#   2. Go to your Synology Drive folder
#   3. Click the address bar at the top
#   4. Copy the path, for example:
#        C:\Users\Zonov\SynologyDrive
#   5. Paste it below, replacing REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH
#   6. You can use \ or / , both work
#
# The final path must include /tokens/arshin-token.json at the end.

TOKEN_FILE_PATH=REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH/tokens/arshin-token.json

# Listen address. Keep 127.0.0.1 for local Chrome Extension only.
TOKEN_AGENT_HOST=127.0.0.1

# Listen port. Chrome extension sends to http://127.0.0.1:8003
TOKEN_AGENT_PORT=8003

# Log file path (optional, default is token-agent.log next to main.py)
# TOKEN_AGENT_LOG=REPLACE_WITH_YOUR_SYNOLOGY_DRIVE_PATH/tokens/token-agent.log
