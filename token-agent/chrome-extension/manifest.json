{
  "manifest_version": 3,
  "name": "ARSHIN Token Relay",
  "version": "1.1.0",
  "description": "Relays ARSHIN auth token to local token-agent",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://fgis.gost.ru/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ARSHIN Token Relay"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fgis.gost.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
