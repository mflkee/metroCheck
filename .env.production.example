# Production окружение metroCheck (шаблон).
# Скопировать в .env.production на сервере: docker-compose.yml читает этот файл
# автоматически (env_file), флаг `--env-file` для запуска не обязателен.
# ВАЖНО: все значения заполнить перед первым запуском — иначе приложение
# стартует на дефолтах, а письма с отчётами молча не отправляются.

# Database
POSTGRES_USER=mkair
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mkair
POSTGRES_PORT=5434

# Ports
BACKEND_PORT=8002
FRONTEND_PORT=8081
REDIS_PORT=6382

# Protocols / tokens
PROTOCOLS_HOST_PATH=/home/mflkee/protocols
METROCHECK_PROTOCOLS_PATH=/protocols
TOKEN_FILE_PATH=/shared/tokens/jwt-arshin-token.json

# External APIs
OPENROUTER_API_KEY=
ARSHIN_BEARER_TOKEN=

# Security
FASTAPI_API_KEY=change-me

# Admin auth (нужен только если ACCOUNTS_ENABLED=false)
ADMIN_USERNAME=admin-metrochek
ADMIN_PASSWORD=

# Email notifications
SMTP_HOST=mail.mkair-it.ru
SMTP_PORT=465
SMTP_USER=robot@mkair-it.ru
SMTP_PASS=
FROM_EMAIL=robot@mkair-it.ru
REPORT_EMAIL=

# Unified account registry (metroAccounts)
ACCOUNTS_ENABLED=false
ACCOUNTS_URL=http://172.17.0.1:8006
ACCOUNTS_SERVICE_NAME=metrocheck
ACCOUNTS_SERVICE_TOKEN=

# App
APP_ENV=production
FRONTEND_APP_URL=https://metrocheck.mkair-it.ru
