# Database
POSTGRES_USER=mkair
POSTGRES_PASSWORD=mkair_secret
POSTGRES_DB=mkair

# External APIs
OPENROUTER_API_KEY=your-key-here
ARSHIN_BEARER_TOKEN=

# Security
FASTAPI_API_KEY=CHANGE_ME_API_KEY

# Admin auth (leave password empty to auto-generate on first start)
ADMIN_USERNAME=admin-metrochek
ADMIN_PASSWORD=

# Token sync via Synology Drive
# Path inside Docker container (mounted from server):
TOKEN_FILE_PATH=/shared/tokens/arshin-token.json

# n8n
N8N_USER=admin
N8N_PASSWORD=admin
N8N_MCP_KEY=metrocheck-mcp-key
N8N_API_KEY=metrocheck-n8n-api-key

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=metrocheck-reports@example.com
REPORT_EMAIL=

# App
APP_ENV=production
