# Пример окружения metroCheck.
# Реальные значения — в .env.production / .env.staging (в git не попадают).
# Бэкенд получает переменные из env-файла (docker-compose: services.backend.env_file),
# поэтому `docker compose up -d` работает без флага `--env-file`.

# Database (используется и для compose-интерполяции DATABASE_URL/портов)
POSTGRES_USER=mkair
POSTGRES_PASSWORD=mkair_secret
POSTGRES_DB=mkair

# External APIs
OPENROUTER_API_KEY=
ARSHIN_BEARER_TOKEN=

# Security
FASTAPI_API_KEY=CHANGE_ME_API_KEY
# Подпись JWT — обязательно свой в prod: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# Время жизни сессии, минуты (5256000 = 10 лет, «один вход»)
ACCESS_TOKEN_EXPIRE_MINUTES=5256000

# Admin auth (пусто = пароль генерируется при первом старте и печатается в лог)
ADMIN_USERNAME=admin-metrochek
ADMIN_PASSWORD=

# Token sync via Synology Drive
# Путь внутри контейнера (монтируется с сервера):
TOKEN_FILE_PATH=/shared/tokens/jwt-arshin-token.json

# Пути протоколов
PROTOCOLS_HOST_PATH=/home/mflkee/protocols
METROCHECK_PROTOCOLS_PATH=/protocols

# Email notifications
# ВАЖНО: без SMTP_USER/SMTP_PASS письма с отчётами не отправляются
# (в /health будет email.status = not_configured).
SMTP_HOST=mail.mkair-it.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@mkair-it.ru
FROM_NAME=metroCheck Robot
REPORT_EMAIL=

# Unified account registry (metroAccounts); при ACCOUNTS_ENABLED=true вход идёт через реестр
ACCOUNTS_ENABLED=false
ACCOUNTS_URL=http://172.17.0.1:8006
ACCOUNTS_SERVICE_NAME=metrocheck
ACCOUNTS_SERVICE_TOKEN=

# App
APP_ENV=development
FRONTEND_APP_URL=https://metrocheck.mkair-it.ru
