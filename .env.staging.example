# Staging окружение metroCheck (шаблон).
# Скопировать в .env.staging на сервере: docker-compose.staging.yml читает файл
# автоматически (env_file), флаг `--env-file` не обязателен.

# Database
POSTGRES_USER=mkair
POSTGRES_PASSWORD=mkair_secret
POSTGRES_DB=mkair_stg
POSTGRES_STG_PORT=5436

# Ports
BACKEND_STG_PORT=9002
FRONTEND_STG_PORT=9081
REDIS_STG_PORT=6383

# Protocols / tokens
PROTOCOLS_HOST_PATH=/home/mflkee/staging_protocols
METROCHECK_PROTOCOLS_PATH=/protocols
TOKEN_FILE_PATH=/shared/tokens/jwt-arshin-token.json

# External APIs
OPENROUTER_API_KEY=
ARSHIN_BEARER_TOKEN=

# Security
FASTAPI_API_KEY=change-me
# Подпись JWT — обязательно свой в prod: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# Время жизни сессии, минуты (5256000 = 10 лет, «один вход»)
ACCESS_TOKEN_EXPIRE_MINUTES=5256000

# Admin auth
ADMIN_USERNAME=admin-metrochek
ADMIN_PASSWORD=

# Email notifications (для staging можно указать те же креды, что и в prod)
SMTP_HOST=mail.mkair-it.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@mkair-it.ru
REPORT_EMAIL=

# Unified account registry (metroAccounts)
ACCOUNTS_ENABLED=false
ACCOUNTS_URL=http://172.17.0.1:8006
ACCOUNTS_SERVICE_NAME=metrocheck
ACCOUNTS_SERVICE_TOKEN=

# App
APP_ENV=staging
FRONTEND_STG_APP_URL=http://100.89.18.223:9081
